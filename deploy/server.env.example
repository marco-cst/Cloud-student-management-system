# Documentation template only. Never start a service with placeholder values.
# Replace all environment-specific values in a protected file outside Git.
# Intended systemd EnvironmentFile: /etc/student-management/server.env (root:root, 0600).
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
# Reserved non-resolving example; replace with your own HTTPS origin, no final /.
APP_ORIGIN=https://example.invalid
COOKIE_SECURE=true
JWT_EXPIRES_IN=15m
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
# Use your own dedicated database and a user restricted to that database.
MONGODB_URI=replace-with-production-atlas-uri
# One Nginx on the same host; overwrite X-Forwarded-For with $remote_addr in Nginx.
TRUST_PROXY=loopback
