# Template only. Replace placeholders in a protected file outside the repository.
# Intended systemd EnvironmentFile: /etc/student-management/server.env (root:root, 0600).
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=https://replace-with-your-dns-name
COOKIE_SECURE=true
JWT_EXPIRES_IN=15m
JWT_SECRET=replace-with-a-new-random-secret-of-at-least-32-characters
# Use a dedicated Atlas database and a database user restricted to that database.
MONGODB_URI=replace-with-production-atlas-uri
# One Nginx on the same host; overwrite X-Forwarded-For with $remote_addr in Nginx.
TRUST_PROXY=loopback
