# Development template only. Copy to .env; never commit the real file.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Local single-node replica set described in README; no production database.
MONGODB_URI=mongodb://127.0.0.1:27017/student_management_dev?replicaSet=rs0
# Generate a new local secret; the application rejects this placeholder.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
# false only for local HTTP. Public deployments require HTTPS and true.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:5173
# Use loopback only behind a trusted local reverse proxy; never true or a hop count.
TRUST_PROXY=false
